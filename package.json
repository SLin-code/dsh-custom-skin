{
  "name": "dsh-custom-skin",
  "version": "0.1.0",
  "description": "Custom wallpapers and translucent skins for DeepSeek Harness Web",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SLin-code/dsh-custom-skin.git"
  },
  "homepage": "https://github.com/SLin-code/dsh-custom-skin#readme",
  "bugs": {
    "url": "https://github.com/SLin-code/dsh-custom-skin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wallpaper",
    "theme",
    "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "docs/images/*.webp",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.7 <0.2.0-0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7 <0.2.0-0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7 <0.2.0-0 || >=0.1.1-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.0-rc.7 <0.2.0-0 || >=0.1.1-rc.1 <0.2.0-0",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
